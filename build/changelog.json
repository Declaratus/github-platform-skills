{
  "api": "https://github.blog/wp-json/wp/v2",
  "lookback_days": 365,
  "plugins": {
    "github-projects-issues-docs": {
      "title": "Projects and Issues",
      "labels": [
        "projects-and-issues"
      ]
    },
    "github-billing-docs": {
      "title": "Billing",
      "labels": [
        "account-management",
        "enterprise-management-tools"
      ],
      "match": "billing|budget|cost cent|invoice|licen[cs]e|payment|spend|sku|metered|pricing|premium request"
    },
    "github-code-security-docs": {
      "title": "Code security",
      "labels": [
        "application-security",
        "supply-chain-security"
      ],
      "lookback_days": 180
    },
    "github-migrations-docs": {
      "title": "Migrations",
      "labels": [
        "enterprise-management-tools"
      ],
      "match": "migrat|importer|\bGEI\b|\bELM\b|ghe-migrator|mannequin"
    }
  }
}
